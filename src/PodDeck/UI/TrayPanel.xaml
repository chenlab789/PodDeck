<Window x:Class="PodDeck.UI.TrayPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PodDeck" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <!-- A full-width row button with a hairline on top -->
        <Style x:Key="Row" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Tag" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource InkLine}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource InkFg}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Border Width="290" CornerRadius="20" Background="{StaticResource InkBg}" BorderBrush="{StaticResource InkBorder}"
                BorderThickness="1" Padding="18,16,18,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.45" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock x:Name="ConnText" DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Bottom"/>
                    <TextBlock x:Name="NameText" Text="AirPods" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkFg}"/>
                </DockPanel>

                <Border BorderBrush="{StaticResource InkLine}" BorderThickness="0,1,0,0" Padding="0,10">
                    <Grid x:Name="BatRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </Border>

                <Button x:Name="PauseRow" Style="{StaticResource Row}" Click="PauseRow_Click"
                        ToolTip="Pauses media when you take AirPods out. Taking both out pauses in about 3-5 s; one pod alone can take 10-20 s (AirPods report the second pod slowly over Bluetooth LE).">
                    <DockPanel>
                        <Border x:Name="PauseSw" DockPanel.Dock="Right" Width="32" Height="18" CornerRadius="9" Padding="2" VerticalAlignment="Center">
                            <Ellipse x:Name="PauseKnob" Width="14" Height="14" Fill="White"/>
                        </Border>
                        <TextBlock Text="Pause on Remove" Style="{StaticResource RowText}"/>
                    </DockPanel>
                </Button>

                <Button x:Name="HudRow" Style="{StaticResource Row}" Click="HudRow_Click"
                        ToolTip="Small battery strip on the right edge of the screen">
                    <DockPanel>
                        <Border x:Name="HudSw" DockPanel.Dock="Right" Width="32" Height="18" CornerRadius="9" Padding="2" VerticalAlignment="Center">
                            <Ellipse x:Name="HudKnob" Width="14" Height="14" Fill="White"/>
                        </Border>
                        <TextBlock Text="Status HUD" Style="{StaticResource RowText}"/>
                    </DockPanel>
                </Button>

                <Button x:Name="StereoRow" Style="{StaticResource Row}" Click="StereoRow_Click"
                        ToolTip="Keep AirPods in stereo and talk through another real microphone">
                    <DockPanel>
                        <Border x:Name="StereoSw" DockPanel.Dock="Right" Width="32" Height="18" CornerRadius="9" Padding="2" VerticalAlignment="Center">
                            <Ellipse x:Name="StereoKnob" Width="14" Height="14" Fill="White"/>
                        </Border>
                        <TextBlock Text="Keep Stereo" Style="{StaticResource RowText}"/>
                    </DockPanel>
                </Button>

                <Border BorderBrush="{StaticResource InkLine}" BorderThickness="0,1,0,0" MinHeight="42">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="soon" FontSize="12" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center"/>
                        <TextBlock Text="Noise control" FontSize="12.5" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <Border BorderBrush="{StaticResource InkLine}" BorderThickness="0,1,0,0" Padding="0,10,0,8">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="VolText" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource InkMuted}"/>
                            <TextBlock Text="Volume" Style="{StaticResource RowText}"/>
                        </DockPanel>
                        <!-- Tall transparent hit area, thin visual line -->
                        <Border x:Name="VolBar" Height="20" Background="Transparent" Cursor="Hand" Margin="0,4,0,0">
                            <Grid VerticalAlignment="Center">
                                <Border Height="4" CornerRadius="2" Background="{StaticResource InkBorder}"/>
                                <Border x:Name="VolFill" Height="4" CornerRadius="2" Background="{StaticResource InkFg}"
                                        HorizontalAlignment="Left" Width="0" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ConnBtn" Style="{StaticResource FlatButton}" Tag="10" Height="34" Background="Transparent"
                            BorderBrush="{StaticResource InkOutline}" BorderThickness="1" Click="ConnBtn_Click">
                        <TextBlock x:Name="ConnBtnText" Text="Use on this PC" FontSize="12" Foreground="{StaticResource InkFg}"/>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource FlatButton}" Tag="10" Height="34" Padding="14,0" Background="Transparent"
                            BorderBrush="{StaticResource InkOutline}" BorderThickness="1" Click="Quit_Click">
                        <TextBlock Text="Quit" FontSize="12" Foreground="{StaticResource InkMuted}"/>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
