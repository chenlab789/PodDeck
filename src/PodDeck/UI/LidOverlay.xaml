<Window x:Class="PodDeck.UI.LidOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PodDeck" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="{StaticResource UiFont}" Opacity="0">
    <Grid Margin="30">
        <Border x:Name="Card" Width="380" CornerRadius="30" Background="#F7FAFAFC" Padding="24,28,24,22">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.22" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Button x:Name="CloseBtn" Style="{StaticResource FlatButton}" Tag="15" Width="30" Height="30"
                        Background="#0F000000" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-12,-8,0"
                        ToolTip="Close" Click="CloseBtn_Click">
                    <Path Data="M1.5,1.5 L8.5,8.5 M8.5,1.5 L1.5,8.5" Stroke="#6E6E73" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10"/>
                </Button>
                <StackPanel>
                    <TextBlock x:Name="NameText" Text="AirPods" FontFamily="{StaticResource UiFontDisplay}" FontSize="19"
                               FontWeight="SemiBold" Foreground="#1D1D1F" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Connected" FontSize="13" Foreground="#6E6E73"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>

                    <UniformGrid Columns="3" Margin="0,22,0,0">
                        <StackPanel x:Name="LeftCol" HorizontalAlignment="Center"/>
                        <StackPanel x:Name="RightCol" HorizontalAlignment="Center"/>
                        <StackPanel x:Name="CaseCol" HorizontalAlignment="Center"/>
                    </UniformGrid>

                    <Button x:Name="ActionBtn" Style="{StaticResource FlatButton}" Tag="12" Height="40" Margin="0,22,0,0"
                            Background="#0F000000" Click="ActionBtn_Click">
                        <TextBlock x:Name="ActionText" Text="Use on this PC" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
